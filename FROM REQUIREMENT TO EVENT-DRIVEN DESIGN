import javax.swing.*;
import javax.swing.event.DocumentEvent;
import javax.swing.event.DocumentListener;
import java.awt.*;
import java.awt.event.*;
import java.util.*;
import java.util.List;

public class AppointmentFrame extends JFrame {
    private final JTextField patientIdField = new JTextField(15);
    private final JComboBox<String> deptComboBox = new JComboBox<>();
    private final JComboBox<String> doctorComboBox = new JComboBox<>();
    private final JComboBox<String> slotComboBox = new JComboBox<>(
            new String[]{"09:00 AM", "10:30 AM", "02:00 PM", "04:00 PM"}
    );
    private final JButton bookButton = new JButton("Book Appointment");
    private final JButton clearButton = new JButton("Clear");
    private final JLabel statusLabel = new JLabel("Ready");

    private final Map<String, List<String>> departmentDoctors = new HashMap<>();
    private boolean isBookingInProgress = false;

    public AppointmentFrame() {
        setTitle("Hospital Outpatient Appointment Desk");
        setSize(420, 260);
        setLayout(new BorderLayout(10, 10));
        setDefaultCloseOperation(JFrame.DO_NOTHING_ON_CLOSE);

        // 1. Load departments and doctors into memory
        departmentDoctors.put("Cardiology", Arrays.asList("Dr. Arjun", "Dr. Meena"));
        departmentDoctors.put("Orthopedics", Arrays.asList("Dr. Karthik", "Dr. Priya"));
        departmentDoctors.put("General Medicine", Arrays.asList("Dr. Ravi", "Dr. Divya"));

        for (String dept : departmentDoctors.keySet()) {
            deptComboBox.addItem(dept);
        }

        // 2. Build Component Hierarchy
        JPanel headerPanel = new JPanel(new FlowLayout(FlowLayout.CENTER));
        headerPanel.add(new JLabel("Outpatient Appointment Desk"));

        JPanel formPanel = new JPanel(new GridLayout(4, 2, 8, 8));
        formPanel.setBorder(BorderFactory.createEmptyBorder(10, 20, 10, 20));
        formPanel.add(new JLabel("Patient ID:"));
        formPanel.add(patientIdField);
        formPanel.add(new JLabel("Department:"));
        formPanel.add(deptComboBox);
        formPanel.add(new JLabel("Doctor:"));
        formPanel.add(doctorComboBox);
        formPanel.add(new JLabel("Time Slot:"));
        formPanel.add(slotComboBox);

        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER));
        buttonPanel.add(bookButton);
        buttonPanel.add(clearButton);

        JPanel footerPanel = new JPanel(new BorderLayout());
        footerPanel.add(buttonPanel, BorderLayout.NORTH);
        statusLabel.setHorizontalAlignment(SwingConstants.CENTER);
        statusLabel.setBorder(BorderFactory.createEmptyBorder(5, 5, 10, 5));
        footerPanel.add(statusLabel, BorderLayout.SOUTH);

        add(headerPanel, BorderLayout.NORTH);
        add(formPanel, BorderLayout.CENTER);
        add(footerPanel, BorderLayout.SOUTH);

        // Populate initial doctors
        refreshDoctors();

        // 3. Register Event Listeners
        patientIdField.getDocument().addDocumentListener(new DocumentListener() {
            public void insertUpdate(DocumentEvent e) { isBookingInProgress = true; }
            public void removeUpdate(DocumentEvent e) { isBookingInProgress = !patientIdField.getText().trim().isEmpty(); }
            public void changedUpdate(DocumentEvent e) { isBookingInProgress = true; }
        });

        deptComboBox.addItemListener(e -> {
            if (e.getStateChange() == ItemEvent.SELECTED) {
                refreshDoctors();
                isBookingInProgress = true;
            }
        });

        bookButton.addActionListener(e -> handleBooking());
        clearButton.addActionListener(e -> handleClear());

        addWindowListener(new WindowAdapter() {
            @Override
            public void windowClosing(WindowEvent e) {
                if (isBookingInProgress) {
                    int choice = JOptionPane.showConfirmDialog(
                            AppointmentFrame.this,
                            "A booking is in progress. Are you sure you want to close?",
                            "Confirm Exit",
                            JOptionPane.YES_NO_OPTION
                    );
                    if (choice == JOptionPane.YES_OPTION) {
                        dispose();
                    }
                } else {
                    dispose();
                }
            }
        });
    }

    private void refreshDoctors() {
        String selectedDept = (String) deptComboBox.getSelectedItem();
        doctorComboBox.removeAllItems();

        List<String> doctors = departmentDoctors.get(selectedDept);
        if (doctors != null) {
            for (int i = 0; i < doctors.size(); i++) {
                doctorComboBox.addItem(doctors.get(i));
            }
        }
    }

    private void handleBooking() {
        String patientId = patientIdField.getText().trim();
        String dept = (String) deptComboBox.getSelectedItem();
        String doctor = (String) doctorComboBox.getSelectedItem();
        String slot = (String) slotComboBox.getSelectedItem();

        if (patientId.isEmpty()) {
            statusLabel.setText("Error: Patient ID is required.");
            return;
        }

        statusLabel.setText("Confirmed: " + patientId + " | " + doctor + " (" + slot + ")");
        isBookingInProgress = false;
    }

    private void handleClear() {
        patientIdField.setText("");
        statusLabel.setText("Ready");
        isBookingInProgress = false;
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            AppointmentFrame frame = new AppointmentFrame();
            frame.setVisible(true);
        });
    }
}
